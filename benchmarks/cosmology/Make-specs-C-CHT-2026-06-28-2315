#!/bin/bash

# Script to make the "cheat" spec files for the cosmology F
# benchmark.  These have exactly the right inventory and not too
# many resources, so performance here should be an upper bound.
# This is the second round of CHT specs, and introduce the
# setting of genome time steps to 3, because it looks like
# many of the problems get bogged down with 4.
# These have higher operand mutation rates.
# These have 4 outputs and 4 scratch.
# These weight multiplication the same as addition

run_set=CHT-2026-06-28-2315

declare -a data_sets super_specs_base super_specs
data_set_dir="Things-to-bench/cosmo_data"
data_set_ext=.csv

super_specs_base=(
    mutation-h2
    weights-3
    genome-arr4
    genome-3ts
    baseline
    this-corpus
)

super_specs=( polynomial polynomial-seed "${super_specs_base[@]}" )
data_sets=( C2a )
source ../Module-Make-specs

super_specs=( rational rational-seed "${super_specs_base[@]}" )
data_sets=( C{3g,3h,5a,5b,5c,5d,5e,5f} )
source ../Module-Make-specs

super_specs=( exp-log exp-log-seed "${super_specs_base[@]}" )
data_sets=( C{1a,1b,1c,1d,2b} )
source ../Module-Make-specs

super_specs=( exp-log-trig exp-log-trig-seed "${super_specs_base[@]}" )
data_sets=( C{6a,6b,6c} )
source ../Module-Make-specs

# These have no known ground truth, so I'll run them with the baseline,
# which has the progressive operation inventory.
super_specs=( "${super_specs_base[@]}" )
data_sets=( C3{a..f} C4{a..e} )
source ../Module-Make-specs
