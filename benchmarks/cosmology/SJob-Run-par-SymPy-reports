#!/bin/bash

#SBATCH --ntasks=64
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

# The --exact here means that the srun will be given the
# resources it requested and not the whole allocation
# given to this sbatch.

find Specs -name '*.toml' -print \
     | parallel --jobs $SLURM_NTASKS \
         srun --quiet --exact --ntasks=1 \
            python SymPyReport.py '{}'

python -u AssembleSymPyReports.py
