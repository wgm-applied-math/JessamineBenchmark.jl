#!/bin/bash

# Script to make spec files that are as much as possible like the
# configurations of other packages in the srbench paper.
# There's a specific set of operations to consider.
# These are uniform across data sets.
# There are variants with 8 and 12 output and scratch slots.

run_set_base=SRB-2026-06-26-1115

declare -a data_sets super_specs
data_set_dir=Things-to-bench/cosmo_data
data_set_ext=.csv
data_sets=( C1{a..d} C2{a,b} C3{a..h} C4{a..e} C5{a..f} C6{a..c} )

run_set="$run_set_base-arr12"
echo "== Working on $run_set =="
super_specs=( srbench-ops srbench-seed baseline this-corpus )
source ../Module-Make-specs

run_set="$run_set_base-arr8"
echo "== Working on $run_set =="
super_specs=( srbench-ops genome-arr8 srbench-seed baseline this-corpus )
source ../Module-Make-specs
