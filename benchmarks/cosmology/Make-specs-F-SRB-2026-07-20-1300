#!/bin/bash

# Script to make specs for some srbench-like configurations.

run_set_base=SRB-2026-07-20-1300

declare -a data_sets super_specs_base super_specs
data_set_dir=Things-to-bench/datasets
data_set_ext=.csv
data_sets=( F{1..8} )

super_specs_base=(
    srbench-ops
    srbench-seed
    generations-100
    genome-arr8
    genome-3ts
    baseline
    this-corpus
    )

run_set="$run_set_base"
echo "== Working on $run_set =="
super_specs=( "${super_specs_base[@]}")
source Module-Make-specs
