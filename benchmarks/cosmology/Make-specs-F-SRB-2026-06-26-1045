#!/bin/bash

# Script to make specs for some srbench-like configurations.
# There are variants with 8 and 12 output and scratch slots.

run_set_base=SRB-2026-06-26-1045

declare -a data_sets super_specs
data_set_dir=Things-to-bench/datasets
data_set_ext=.csv
data_sets=( F{1..8} )

run_set="$run_set_base-arr12"
echo "== Working on $run_set =="
super_specs=( srbench-ops genome-3ts srb-seed baseline this-corpus )
source ../Module-Make-specs

run_set="$run_set_base-arr8"
echo "== Working on $run_set =="
super_specs=( srbench-ops genome-3ts genome-8arr srb-seed baseline this-corpus )
source ../Module-Make-specs
