#!/bin/bash

# Script to make the "cheat" spec files for the cosmology C
# benchmark.  These have exactly the right inventory and not too
# many resources, so performance here should be an upper bound.

run_key=CHT-2026-06-26-1100

declare -a data_sets super_specs
data_set_dir=Things-to-bench/cosmo_data
data_set_ext=.csv

super_specs=( polynomial polynomial-seed genome-3ts baseline this-corpus )
data_sets=( C{2a,5f})
source ../Module-Make-specs

super_specs=( rational rational-seed baseline this-corpus )
data_sets=( C{3g,3h,5a,5b,5c,5d,5e} )
source ../Module-Make-specs

super_specs=( exp-log exp-log-seed baseline this-corpus )
data_sets=( C{1a,1b,1c,1d,2b} )
source ../Module-Make-specs

super_specs=( exp-log-trig exp-log-trig-seed baseline this-corpus )
data_sets=( C{6a,6b,6c} )
source ../Module-Make-specs

# These have no known ground truth, so I'll run them with the baseline.
super_specs=( baseline this-corpus )
data_sets=( C3{a..f} C4{a..e} )
source ../Module-Make-specs
