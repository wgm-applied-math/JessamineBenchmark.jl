#!/bin/bash

# Script to make specs for some srbench-like configurations.
# This creates an extra 160 samples for some problems where
# success is rare enough that it's hard to measure from 32.  With
# 160 samples plus the original 32 = 196, that's 48 hours worth
# of effort.
# Otherwise the configuration is the same as SRB-2026-07-20-1130.

run_set_base=SRB-2026-07-25-1900

declare -a data_sets super_specs_base super_specs
data_set_dir=Things-to-bench/cosmo_data
data_set_ext=.csv
data_sets=( C3h )

super_specs_base=(
    more-samples
    srbench-ops
    srbench-seed
    generations-100
    genome-arr8
    genome-3ts
    baseline
    this-corpus
)

run_set="$run_set_base"
echo "== Working on $run_set =="
super_specs=( "${super_specs_base[@]}" )
source Module-Make-specs
