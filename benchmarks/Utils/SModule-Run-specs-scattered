#!/bin/bash

# Partial script:
# Set up a slurm batch script
# Set data_sets to an array of data set keys
# Set run_set to a configuration run key
# Then source this script

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Source this script within a slurm script"
    exit 1
fi

# This should flush any recompilation
julia --project=@. -q -m JessamineCLI.AppSimple -- sr --version

# Make a filename glob expand to nothing instead of the literal glob
# if there are no matches.
shopt -s nullglob

function maybe_run_spec {
    spec="$1"
    output_file_stem=$(tomlq -r '.output_file_stem' "$spec")
    output_file="$output_file_stem.json"
    output_dir=$(dirname "$output_file")
    if [ -f "$output_file" ]
    then
        echo "Skipping $spec: Output file already exists: $output_file"
    else
        echo "Scheduling build of $output_file"
        srun --quiet --exact --ntasks=1 --nodes=1 \
             --output "$output_dir/stdout-%J.txt" \
             --error "$output_dir/stderr-%J.txt" \
             ./Run-one-spec "$spec"
    fi
}

# Make available to parallel:
export -f maybe_run_spec

for data_set in "${data_sets[@]}"
do
    find "Specs/$run_set" -name "$data_set-*.toml" -print \
done | parallel --jobs $SLURM_NTASKS maybe_run_spec '{}'
