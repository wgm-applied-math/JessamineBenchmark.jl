#!/bin/bash

# Check that the data sets exist.
# If not, make them.
data_files=( datasets/sin*.csv )
if (( ${#data_files[@]} < 7 ))
then
    echo "= Making data files ="
    ./Make-sin-data
fi

# Make spec files.
#
# This makes files `Specs/SRB-2026-06-25-1715/*.toml`, one for each
# micro-trial.
echo "= Making spec files ="
./Make-specs-SRB-2026-06-25-1715

# Run all spec files.
#
# This submits a batch job to Slurm to run a micro-trial for each
# file Specs/SRB-2026-06-25-1715/*.toml.
echo "= Submitting batch files ="
sbatch --ntasks=512 SJob-Run-specs-scattered

# Once the above batch job has run successfully, run the following:
#
#     sbatch SJob-Run-SymPy-reports
#
# Once that batch job has run successfully, run the following:
#
#    python AssembleSymPyReports.py
#    python MakeSummaries.py
#
# Now open `Analysis.ipynb` in Jupyter and run it.
