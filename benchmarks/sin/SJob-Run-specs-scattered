#!/bin/bash

#SBATCH --ntasks=256
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

declare -a data_sets run_sets
data_sets=( sin-{wide-,}noise-{0,1,2} )

run_sets=(
    SRB-2026-06-25-1715{,-L2,-L4}
)
for run_set in "${run_sets[@]}"
do
    echo "Working on $run_set"
    source ../SModule-Run-specs-scattered
done

wait
