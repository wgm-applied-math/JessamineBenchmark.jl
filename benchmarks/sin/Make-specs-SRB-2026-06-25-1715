#!/bin/bash

# Script to make specs for some srbench-like configurations.

run_set_base=SRB-2026-06-25-1715

declare -a data_sets super_specs
data_set_dir=datasets
data_sets=( sin-{wide-,}noise-{0,1,2} )
data_set_ext=.csv

super_specs_base=(
    srbench-ops
    srbench-seed
    genome-arr8
    genome-3ts
    baseline
    this-corpus
    )

run_set="$run_set_base"
echo "== Working on $run_set =="
super_specs=( "${super_specs_base[@]}" )
source ../Module-Make-specs

run_set="$run_set_base-L2"
echo "== Working on $run_set =="
super_specs=( lambda-2 "${super_specs_base[@]}" )
source ../Module-Make-specs

run_set="$run_set_base-L4"
echo "== Working on $run_set =="
super_specs=( lambda-4 "${super_specs_base[@]}" )
source ../Module-Make-specs
