Cell[BoxData[
 RowBox[{"postLeft", "[", 
  RowBox[{"4", ",", "32"}], "]"}]], "Input",
 CellChangeTimes->{{3.994087152742344*^9, 3.994087161662105*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"06db0c4c-491c-4bfd-9044-7f8495a0db19"],

Cell[TextData[{
 "Given ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "261132cd-1b82-4cb2-b036-f29f9a470809"],
 ", with 95% credibility, the probability of at least one success in 32 is \
therefore"
}], "Text",
 CellChangeTimes->{{3.994087452924069*^9, 3.9940874874651413`*^9}, {
  3.994087533756406*^9, 3.994087542373653*^9}, {3.994093229071138*^9, 
  3.9940932294301043`*^9}},ExpressionUUID->"5e49b1ec-359c-4f41-b1e7-\
59254e55a4a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"1", "-", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "r"}], ")"}], "32"]}], "/.", 
  RowBox[{"r", "->", 
   RowBox[{"postLeft", "[", 
    RowBox[{"4", ",", "32"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.994087488124144*^9, 3.994087527605331*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"550d1316-406e-4308-8580-0c5d2f9ca898"],

Cell[TextData[{
 "This calculation means that with 95% credibility, the probability of at \
least one success in 8 hours (32 attempts) given ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e16335d5-8805-417b-83e3-41cac3609711"],
 " successes in the first  32 attempts is at least the number in this table. \
(For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " ", "=", " ", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "814986f1-1ed1-4b7f-9ac8-f993f7429991"],
 " the lower bound is ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "037985e1-210c-47cf-869e-68670cd381db"],
 ", which is intuitively correct.)"
}], "Text",
 CellChangeTimes->{{3.994087624917841*^9, 3.994087627312071*^9}, {
   3.994087678798843*^9, 3.9940877276695213`*^9}, {3.994087773479403*^9, 
