Cell[TextData[{
 "If I ask about one additional trial, things look more inuitive for small ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca40dec3-8151-4a92-9294-8db508f68ee1"],
 ":"
