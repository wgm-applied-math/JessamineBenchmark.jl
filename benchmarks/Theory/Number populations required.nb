Notebook[{

Cell[CellGroupData[{
Cell["Theory: Number of populations required", "Title",
 CellChangeTimes->{{3.994092672084778*^9, 
  3.994092680113093*^9}},ExpressionUUID->"f2cf8bc6-954c-42fd-85f8-\
ce297c44507e"],

Cell[BoxData[
 RowBox[{"SetDirectory", "[", 
  RowBox[{"NotebookDirectory", "[", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9940926607762327`*^9, 3.994092667530561*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"646d5d3f-0c57-41c4-9a62-81a95c53ce96"],

Cell[TextData[{
 "This is the basic beta-like integral. And remember than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "!"}], " ", "=", " ", 
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{"n", "+", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e894dca-dcea-4685-a09b-6fe8194ce812"],
 "."
}], "Text",
 CellChangeTimes->{{3.994092684879917*^9, 
  3.994092717815382*^9}},ExpressionUUID->"06a2557c-8121-4bc8-b3e3-\
7d58f6ce0bc7"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "a"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "b"]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "\[Element]", "Integers"}], ",", 
      RowBox[{"b", "\[Element]", "Integers"}], ",", 
      RowBox[{"a", ">", "0"}], ",", 
      RowBox[{"b", ">", "0"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994000141524582*^9, 3.994000183140008*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"9093a2d0-1c7e-494a-a03d-10a6c9cd18fd"],

Cell[TextData[{
 "The posterior density for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", " ", "=", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9614d86-8ff4-4adf-bb02-4ee84848a608"],
 "probability of success in one micro-trial is proportional to this:"
}], "Text",
 CellChangeTimes->{{3.994092729229252*^9, 
  3.994092764856929*^9}},ExpressionUUID->"ffd64f93-a456-4acf-80ec-\
fa1032371e7f"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["r", "m"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "r"}], ")"}], 
     RowBox[{"n", "-", "m"}]]}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "\[Element]", "Integers"}], ",", 
      RowBox[{"n", "\[Element]", "Integers"}], ",", 
      RowBox[{"m", ">", "0"}], ",", 
      RowBox[{"n", ">", "m"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.965210716140905*^9, 3.9652107241278963`*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"187813a6-5f3a-477e-9a41-30a93d1699f3"],

Cell[TextData[{
 "which can also be expressed as\n",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "+", "1"}], ")"}], 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"n"},
        {"m"}
       }], "\[NoBreak]", ")"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef4302ec-535b-4c1d-b62e-adbed84dedcf"],
 "\nas confirmed here:"
}], "Text",
 CellChangeTimes->{{3.994092808742243*^9, 
  3.9940928613705187`*^9}},ExpressionUUID->"f9b9843f-1393-4bbe-8144-\
65d5cffbfd1a"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", "m"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "-", "m", "+", "n"}], "]"}]}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "+", "n"}], "]"}]], "==", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}], 
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", "m"}], "]"}]}]]}], "//", "FunctionExpand"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "\[Element]", "Integers"}], ",", 
      RowBox[{"n", "\[Element]", "Integers"}], ",", 
      RowBox[{"m", ">", "0"}], ",", 
      RowBox[{"n", ">", "m"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99399891326982*^9, 3.993998971120207*^9}, {
  3.993999018639958*^9, 3.993999106913074*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"93b08f97-04b8-4611-9919-5e05430ed904"],

Cell[TextData[{
 "This is the posterior probability of getting  no successes in ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b306b71d-02b0-445b-a045-e13a88154706"],
 " more micro-trials given that we got ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4bcf754-353a-42fb-8957-4ada35ba6b96"],
 " micro-successes in ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "728c36da-165b-4bd7-9282-2a74e6f210f4"],
 " micro-trials. The prior is uniform However, this line of thinking leads to \
a sort of mean estimate. For a credible interval (Bayesian equivalent to a \
confidence interval) we\[CloseCurlyQuote]ll need a different approach."
}], "Text",
 CellChangeTimes->{{3.994092868546055*^9, 
  3.994092981804593*^9}},ExpressionUUID->"9f46a67b-7690-42a2-82fa-\
85b3bd3c8b55"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"Beta", "[", 
    RowBox[{
     RowBox[{"m", "+", "1"}], ",", 
     RowBox[{"n", "-", "m", "+", "1"}]}], "]"}]], 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "r"}], ")"}], "k"], 
     SuperscriptBox["r", "m"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "r"}], ")"}], 
      RowBox[{"n", "-", "m"}]]}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "\[Element]", "Integers"}], ",", 
       RowBox[{"m", "\[Element]", "Integers"}], ",", 
       RowBox[{"n", "\[Element]", "Integers"}], ",", 
       RowBox[{"k", ">", "0"}], ",", 
       RowBox[{"m", ">", "0"}], ",", 
       RowBox[{"n", ">", "m"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.964869561080068*^9, 3.964869594940892*^9}, {
  3.964869630192135*^9, 3.964869633874145*^9}, {3.964869770168573*^9, 
  3.96486986998004*^9}, {3.965209188604301*^9, 3.965209190658331*^9}, {
  3.9652100434407578`*^9, 3.965210064976555*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"44e0d245-d3b9-4748-8867-6e23e92cc2a7"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", "m"}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", "k", "-", "m", "+", "n"}], "]"}]}], 
     RowBox[{
      RowBox[{"Beta", "[", 
       RowBox[{
        RowBox[{"1", "+", "m"}], ",", 
        RowBox[{"1", "-", "m", "+", "n"}]}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "+", "k", "+", "n"}], "]"}]}]], "==", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], 
      RowBox[{"Binomial", "[", 
       RowBox[{"n", ",", "m"}], "]"}]}], 
     RowBox[{
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"n", "+", "k"}], ",", "m"}], "]"}], 
      RowBox[{"(", 
       RowBox[{"n", "+", "k", "+", "1"}], ")"}]}]]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", ">", "0"}], ",", 
     RowBox[{"k", ">", "0"}], ",", 
     RowBox[{"n", ">", "m"}], ",", 
     RowBox[{"m", "\[Element]", "Integers"}], ",", 
     RowBox[{"n", "\[Element]", "Integers"}], ",", 
     RowBox[{"k", "\[Element]", "Integers"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.965209009715358*^9, 3.9652090100807056`*^9}, {
  3.965210072381157*^9, 3.965210106725546*^9}, {3.965210176136771*^9, 
  3.965210210582511*^9}, {3.965210864109611*^9, 3.9652108653347797`*^9}, {
  3.994093032640801*^9, 3.994093036093532*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"200c8d44-b8ed-4c71-b347-e81ff4b27cac"],

Cell[TextData[{
 "The probability of at least one success in ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a763d00f-54e9-433b-9098-a096363d5e3c"],
 " trials given the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab30c646-3052-4c0e-ba0f-f070c4f07b8e"],
 " successes in the original ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc1377e4-5926-4df8-b942-32c29ec4aebc"],
 " trials should be this:"
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.994004443861527*^9, 
  3.994004469399856*^9}},ExpressionUUID->"dbb2697c-1892-4543-b289-\
5cfd216f5988"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pSuc", "[", 
   RowBox[{"k_", ",", "m_", ",", "n_"}], "]"}], "=", 
  RowBox[{"1", "-", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "+", "1"}], ")"}], 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", "m"}], "]"}]}], 
    RowBox[{
     RowBox[{"Binomial", "[", 
      RowBox[{
       RowBox[{"n", "+", "k"}], ",", "m"}], "]"}], 
     RowBox[{"(", 
      RowBox[{"n", "+", "k", "+", "1"}], ")"}]}]]}]}]], "Input",
 CellChangeTimes->{{3.964870036076931*^9, 3.964870042587563*^9}, {
  3.964870101733938*^9, 3.964870105114558*^9}, {3.965208925506145*^9, 
  3.9652089639509583`*^9}, {3.965210887904125*^9, 3.965210916491267*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"6742a7e9-3446-4676-a7e5-d0db34a1ce0a"],

Cell[TextData[{
 "For a repeated macro-trial, we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "==", " ", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f843bcf-a2ff-4be6-86c1-bb852dccfa16"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994093055973234*^9, 
  3.99409307094763*^9}},ExpressionUUID->"d7e58295-49aa-48b6-bea8-\
739fc73ec1d8"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "\[Element]", "Integers"}], ",", 
     RowBox[{"n", "\[Element]", "Integers"}], ",", 
     RowBox[{"m", ">", "0"}], ",", 
     RowBox[{"n", ">", "m"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"pSuc", "[", 
     RowBox[{"n", ",", "m", ",", "n"}], "]"}], "//", "FullSimplify"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.993999946214517*^9, 3.993999987198886*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"e3afff3c-8275-4967-bc09-98d464a9292f"],

Cell[TextData[{
 "These probabilities are intuitively too high, particularly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "821e7306-467b-4477-8793-41a91b66b7df"],
 ". I think the problem is that if you think of 32 micro-trials as a single \
macro-experiment, we ran it once (",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2e02386-4b15-41a6-b2bf-f4518d519266"],
 ") and got one macro-failure (",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "cbb578db-680b-4807-b2b1-5687bc3f4529"],
 "), which doesn\[CloseCurlyQuote]t tell us much about what would happen if \
we ran it again, hence the ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "2c0f2ad4-3080-47d8-b0dd-afa4c8053969"],
 " ish.  But once we get to 4 successes, things look very optimistic, 97% \
chance of at least one success in a re-run."
}], "Text",
 CellChangeTimes->{{3.994000377571185*^9, 3.994000388631625*^9}, {
  3.99400451773669*^9, 3.9940045361559343`*^9}, {3.99400705014863*^9, 
  3.9940071642330923`*^9}, {3.994010649879244*^9, 3.994010650581222*^9}, {
  3.994010684722912*^9, 3.9940106991822577`*^9}, {3.9940931167623167`*^9, 
  3.9940931489908457`*^9}},ExpressionUUID->"27474776-874f-4e8b-a090-\
c9966c9f9811"],

Cell[BoxData[
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{
       RowBox[{"pSuc", "[", 
        RowBox[{"32", ",", "m", ",", "32"}], "]"}], "//", "N"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "32"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9940002735556726`*^9, 3.994000358383335*^9}, {
  3.9940004104288073`*^9, 3.99400042036143*^9}, {3.994000667444879*^9, 
  3.994000672698299*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"60134b95-e5bb-44fb-a268-a8f6b23bf73f"],

Cell[TextData[{
 "If I ask about one additional trial, things look more intuitive for small \
",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "ca40dec3-8151-4a92-9294-8db508f68ee1"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994004571840423*^9, 3.994004588802134*^9}, {
   3.9940107173176727`*^9, 3.994010721192227*^9}, 
   3.994086152819478*^9},ExpressionUUID->"81e6435c-8bd6-48fc-aeb0-\
80be68cf687c"],

Cell[BoxData[
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{
       RowBox[{"m", "/", "32"}], "//", "N"}], ",", 
      RowBox[{
       RowBox[{"pSuc", "[", 
        RowBox[{"1", ",", "m", ",", "32"}], "]"}], "//", "N"}]}], "}"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "32"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9940002735556726`*^9, 3.994000358383335*^9}, {
  3.9940004104288073`*^9, 3.99400042036143*^9}, {3.994000661589498*^9, 
  3.994000690456645*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"bb0d3fa9-2f19-4fd7-97de-55ca8ee31506"],

Cell[TextData[{
 "I think what\[CloseCurlyQuote]s going on is that the uniform \
(uninformative) prior ends up saying that if we got no successes in the \
initial ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0713f9e6-033b-48cc-89c1-a5f027181910"],
 " trials, then it doesn\[CloseCurlyQuote]t know whether a success will occur \
or not in another ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36a1ccfb-1cd5-483e-a0fe-f28d1146a143"],
 " trials, which comes out as a bit less than ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6ded2c1-9f39-4ab6-b303-1e782dcd17d7"],
 "."
}], "Text",
 CellChangeTimes->{{3.994001652397279*^9, 3.994001723987632*^9}, {
  3.994004602460445*^9, 
  3.994004622628528*^9}},ExpressionUUID->"64e04342-d4a1-415a-be2c-\
f4de1594d589"],

Cell[BoxData[
 RowBox[{"pSuc", "[", 
  RowBox[{"n", ",", "0", ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.994000859850018*^9, 3.994000863416235*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"2caf6f92-f8ee-4bb6-ba89-37d9ac486342"],

Cell[TextData[{
 "Quick confirmation: If we say that when no successes occur in the first n \
trials, we have to estimate the probability of success at ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"1", "+", "n"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "845160f4-2d58-445d-bdf2-d0fcdb4a7e95"],
 ". From there, in the best case, in ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b125825-d64a-4bdd-9c94-a061c994f298"],
 " more trials the probability of a success is"
}], "Text",
 CellChangeTimes->{{3.994001750262082*^9, 3.994001835061554*^9}, 
   3.994004638333674*^9},ExpressionUUID->"105ddd61-cc44-4d5e-8ceb-\
73b04c087685"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"1", "-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["1", 
        RowBox[{"1", "+", "n"}]]}], ")"}], "n"]}], ",", 
   RowBox[{"n", "->", "\[Infinity]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9940010073032513`*^9, 3.99400102786413*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"b646000d-6fd1-4f23-9be0-54916917b63c"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"1", "-", 
   FractionBox["1", "E"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9940010489133387`*^9, 3.994001058609786*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"b47203a2-071d-4e22-a9a2-b87d7418e394"],

Cell[TextData[{
 "I think I\[CloseCurlyQuote]m going to have do to a different calculation \
anyway. The posterior distribution of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4cd0456-ff34-4790-b123-61b0946f3c08"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Beta", "[", 
    RowBox[{
     RowBox[{"m", "+", "1"}], ",", 
     RowBox[{"n", "+", "m", "+", "1"}]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2248cd95-8693-4774-9aab-cb36851e98ed"],
 ". The 95% credible interval (going to 1 on the right) is found as follows."
}], "Text",
 CellChangeTimes->{{3.994086169185297*^9, 3.994086176553755*^9}, {
  3.994086921923394*^9, 3.994086952507042*^9}, {3.994086997084857*^9, 
  3.994087010907793*^9}, {3.994087663701888*^9, 3.99408766580649*^9}, {
  3.994093195087241*^9, 
  3.994093200213093*^9}},ExpressionUUID->"b484bca7-d324-4ca3-8969-\
2480d19b05a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"postLeft", "[", 
   RowBox[{"m_", ",", "n_", ",", 
    RowBox[{"h", ":", "_", ":", "0.05"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"x", ",", "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"BetaDistribution", "[", 
        RowBox[{
         RowBox[{"m", "+", "1"}], ",", 
         RowBox[{"n", "+", "m", "+", "1"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"x", "/.", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"d", ",", "x"}], "]"}], "==", "h"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Mean", "[", "d", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
