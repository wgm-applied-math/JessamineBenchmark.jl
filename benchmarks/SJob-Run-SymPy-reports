#!/bin/bash

#SBATCH --ntasks=40
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

# Enable ** globs
shopt -s globstar

for file in Specs/**/*.toml
do
    # The --exact here means that the srun will be given the
    # resources it requested and not the whole allocation
    # given to this sbatch.
    srun --quiet --exact --ntasks=1 --cpus-per-task=1 --nodes=1 \
        python SymPyReport.py --force "$file" &
done

wait

python -u AssembleSymPyReports.py
