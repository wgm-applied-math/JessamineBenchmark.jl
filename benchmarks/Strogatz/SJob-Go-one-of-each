#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

declare -a psets

psets=( d_{bacres,barmag,glider,lv,predprey,sfgrid,shearflow,vdp}{1,2} )

for p in "${psets[@]}"
do
    # The --exact here means that the srun will be given the
    # resources it requested and not the whole allocation
    # given to this sbatch.
    srun --exact --ntasks=1 ./Go-one-dataset $p &
done

# Wait for all background tasks to exit
wait
