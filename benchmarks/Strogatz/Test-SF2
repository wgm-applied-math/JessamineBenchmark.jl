#!/bin/bash
dataset=d_shearflow2
mkdir -p Generated
julia --project=@. -m JessamineBenchmark.AppSimple \
    sr \
    --data-file "ode-strogatz/$dataset.txt" \
    --op-inventory "Trig" \
    --output-size 12 \
    --scratch-size 12 \
    --num-time-steps 3 \
    --max-generations 25 \
    --max-time 7200 \
    --lambda-op 1e-6 \
    --output-file "Generated/$dataset.json"
