#!/bin/bash

# Script to make a bunch of spec files for the rational function problems

declare -a psets

psets=( d_{bacres,predprey}{1,2} )

run_key=2026-06-16-2230

for p in "${psets[@]}"
do
julia --project=@. -q -m JessamineBenchmark.AppSimple \
      setup_samples \
      --config-file "rational-function-super-spec.toml" \
      --config-path-template "Specs/$run_key/$p-%03d.toml" \
      --sr-output-dir "Generated/$run_key" \
      --data-file "ode-strogatz/$p.txt"
done
