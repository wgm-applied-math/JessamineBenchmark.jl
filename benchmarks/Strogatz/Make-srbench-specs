#!/bin/bash

# Script to make spec files that are as much as possible like the
# configurations of other packages in the srbench paper.
# There's a specific set of operations to consider.

# Run key 2026-06-21-2100
# - Baseline with op inventory set to "+ - * / sqrt exp log sin cos"

# Run key 2026-06-24-1500
# - Baseline with op inventory set to "+ - * / sqrt exp log sin cos"
# - Output and scratch sizes are set to 8, keeping parameter size at 3
# - Important: num_time_steps = 3
# - Important: max_generations = 100
# - Important: num_to_keep = 75, num_to_generate = 25
#
# The idea is to have shallower expressions by reducing genome time steps,
# while allowing more generations for simplification.
# Modifying the selection numbers reduces selection by mortality.
# Generally less successful on this corpus than 2026-06-21-2100.

declare -a run_keys=( 2026-06-21-2100 2026-06-24-1500 )

declare -a data_sets super_specs
data_set_dir=ode-strogatz
data_sets=( d_{bacres,barmag,glider,lv,predprey,sfgrid,shearflow,vdp}{1,2} )
data_set_ext=.txt

for run_key in "${run_keys[@]}"
do
    super_specs=( srbench-$run_key.toml baseline.toml this-corpus.toml )
    source ../Module-Make-specs
done
