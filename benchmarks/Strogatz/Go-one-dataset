#!/bin/bash
dataset=${1:-d_vdp}
mkdir -p Generated

progress_file_stem="Generated/$dataset/progress"
out_file_stem="Generated/$dataset/result"
log_file="Generated/$dataset.log"
err_file="Generated/$dataset.errlog"

if [ -f "$out_file_stem.json" ]
then
    echo "Output file already exists: $out_file_stem.json"
else
    echo "Generating $out_file_stem"
    rm -f "$log_file" "$err_file"
    julia --project=@. -m JessamineCLI.AppSimple -- \
        sr \
        --data-file "ode-strogatz/$dataset.txt" \
        --op-inventory "Polynomial; RationalFunction; ExpLog; Trig; Hyperbolic" \
        --output-size 12 \
        --scratch-size 12 \
        --num-time-steps 3 \
        --max-generations 25 \
        --max-time 7200 \
        --lambda-op 1.0e-6 \
        --progress-file-stem "$progress_file_stem" \
        --output-file-stem "$out_file_stem" \
        > "$log_file" 2> "$err_file"
    echo "Done generating $out_file"
fi
