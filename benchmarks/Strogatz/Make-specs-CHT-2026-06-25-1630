#!/bin/bash

# Script to make the "cheat" spec files for the Strogatz
# benchmark.  These have exactly the right inventory and not too
# many resources, so performance here should be an upper bound.

run_set=CHT-2026-06-25-1630

declare -a data_sets super_specs
data_set_dir=ode-strogatz
data_set_ext=.txt

super_specs=( polynomial polynomial-seed genome-3ts genome-8arr baseline this-corpus )
data_sets=( d_{lv,vdp}{1,2} )
source ../Module-Make-specs

super_specs=( rational rational-seed baseline this-corpus )
data_sets=( d_{bacres,predprey}{1,2} )
source ../Module-Make-specs

super_specs=( trig trig-seed baseline this-corpus )
data_sets=( d_{barmag,glider,sfgrid,shearflow}{1,2} )
source ../Module-Make-specs
