#!/bin/bash

# Script to make the primary spec files for the Strogatz benchmark.
# These generally succeed on all data sets.

run_set=2026-06-21-2030

declare -a data_sets super_specs
data_set_dir=ode-strogatz
data_set_ext=.txt

super_specs=( short baseline this-corpus )
data_sets=( d_{lv,vdp}{1,2} )
source ../Module-Make-specs

super_specs=( long baseline this-corpus )
data_sets=( d_{bacres,predprey}{1,2} )
source ../Module-Make-specs

super_specs=( long baseline this-corpus )
data_sets=( d_{barmag,glider,sfgrid,shearflow}{1,2} )
source ../Module-Make-specs
