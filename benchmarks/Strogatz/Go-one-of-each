#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
  echo "Run this script within slurm"
  exit 1
fi

declare -a psets

psets=(d_bacres1
d_bacres2
d_barmag1
d_barmag2
d_glider1
d_glider2
d_lv1
d_lv2
d_predprey1
d_predprey2
d_sfgrid1
d_sfgrid2
d_shearflow1
d_shearflow2
d_vdp1
d_vdp2)

for p in "${psets[@]}"
do
  # The --exact here means that the srun will be given the
  # resources it requested and not the whole allocation
  # given to this sbatch.
  srun --exact --ntasks=1 ./Go-one-dataset $p &
done

# Wait for all background tasks to exit
wait
