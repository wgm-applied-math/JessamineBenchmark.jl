#!/bin/bash

# Script to make a bunch of spec files

# These are based on the srbench specs from the Strogatz benchmark.

# 2026-21-2100:
# Not very successful
# Same as baseline but
# - srbench operation inventory

# 2026-24-1430:
# Generally successful
# Same as baseline but
# - srbench operation inventory
# - 8 output and 8 scratch
# - 3 genome time steps
# - 100 generations
# - weak selection by mortality



declare -a data_sets super_specs
data_set_dir=datasets
data_sets=( f1{a,b,c,d} )
data_set_ext=.csv

for run_key in 2026-06-21-2100 # 2026-06-24-1500
do
    echo "== Working on $run_key =="
    super_specs=( srbench-super-spec-$run_key.toml baseline.toml this-corpus.toml )
    source ../Module-Make-specs
done
