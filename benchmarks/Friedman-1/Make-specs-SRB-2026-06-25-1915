#!/bin/bash

# Script to make specs for some srbench-like configurations.
# There are variants with 8 and 12 output and scratch slots.
# These specs run 100 generations, which turns out not to help much.

run_key_base=SRB-2026-06-25-1915

declare -a data_sets super_specs
data_sets=( f1{a,b} )
data_set_dir=datasets
data_set_ext=.csv

run_key="$run_key_base-arr12"
super_specs=( srbench-ops more-generations-100 genome-3ts srb-seed baseline this-corpus )
source ../Module-Make-specs

run_key="$run_key_base-arr8"
super_specs=( srbench-ops more-generations-100 genome-3ts genome-8arr srb-seed baseline this-corpus )
source ../Module-Make-specs
