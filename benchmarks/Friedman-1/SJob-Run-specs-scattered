#!/bin/bash

#SBATCH --ntasks=64
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

declare -a data_sets run_sets

data_sets=( f1{a,b,c,d}{,w} )
run_sets=(
    SRB-2026-07-13-1130
    CHT-2026-08-01-1800
)
for run_set in "${run_sets[@]}"
do
    source SModule-Run-specs-scattered
done

data_sets=( f1{b,d}{,w} )
run_sets=(
    SRB-2026-07-13-1130-subset
    CHT-2026-08-01-1800-subset
)
for run_set in "${run_sets[@]}"
do
    source SModule-Run-specs-scattered
done
