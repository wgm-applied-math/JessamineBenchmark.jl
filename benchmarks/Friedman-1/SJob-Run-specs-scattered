#!/bin/bash

#SBATCH --ntasks=64
#SBATCH --cpus-per-task=1

if [[ ! -v SLURM_JOB_ID ]]
then
    echo "Run this script within slurm"
    exit 1
fi

declare -a data_sets run_sets

data_sets=( f1{a,b,c,d}{,w} )
run_sets=(
    CHT-2026-06-25-1700
    SRB-2026-06-25-1715-arr8
    SRB-2026-07-13-1130
)
for run_set in "${run_sets[@]}"
do
    source SModule-Run-specs-scattered
done

data_sets=( f1{b,d}{,w} )
run_sets=(
    CHT-2026-06-25-1700-subset
    SRB-2026-06-25-1715-subset
    SRB-2026-07-13-1130-subset
)
for run_set in "${run_sets[@]}"
do
    source SModule-Run-specs-scattered
done
