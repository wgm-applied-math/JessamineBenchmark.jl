#!/bin/bash

# Script to make specs for some srbench-like configurations.

run_set_base=SRB-2026-06-25-1715

declare -a data_sets super_specs_base super_specs
data_sets=( f1{a,b,c,d} )
data_set_dir=datasets
data_set_ext=.csv

super_specs_base=(
    srbench-ops
    srbench-seed
    genome-arr8
    genome-3ts
    baseline
    this-corpus
    )

run_set="$run_set_base-arr8"
echo "== Working on $run_set =="
super_specs=( "${super_specs_base[@]}" )
source Module-Make-specs

run_set="$run_set_base-subset"
data_sets=( f1{b,d} )
echo "== Working on $run_set =="
super_specs=( subset-100 "${super_specs_base[@]}" )
source Module-Make-specs
