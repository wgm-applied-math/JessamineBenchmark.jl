#!/bin/bash

# Script to make spec files for the F datasets.

# A lot of experimenting here.

# Two good ones:
# 2026-06-24-1415
# - just the Trig inventory
# - reduce to 8 outputs and 8 scratch
# - 3 genome timesteps instead of 4
# - weaker selection by mortality
# - 100 generations

# 2026-06-24-1430
# Like 1415 but
# - back to 12 outputs and 12 scratch

declare -a data_sets super_specs
data_sets=( f1{a,b} )
data_set_dir=datasets
data_set_ext=.csv
# run_key=2026-06-24-1100
# run_key=2026-06-24-1200
# run_key=2026-06-24-1315
# run_key=2026-06-24-1415

for run_key in 2026-06-24-1415 2026-06-24-1430
do
    echo "== Working on $run_key =="
    super_specs=(specialized-super-spec-$run_key.toml baseline.toml this-corpus.toml)
    source ../Module-Make-specs
done
