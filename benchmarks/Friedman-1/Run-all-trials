#!/bin/bash

# Check that the data sets exist.
# If not, make them.
stems=( f1{a,b,c,d}{,w} )
for stem in "${stems[@]}"
do
    data_file="datasets/$stem.csv"
    if [ ! -f "$data_file" ]
    then
        echo "= Making $data_file ="
        ./Make-$stem
    fi
    if [ ! -f "$data_file" ]
    then
        echo "= Making $data_file failed, exiting ="
        exit 1
    fi
done

# Make spec files
echo "= Making spec files ="
./Make-specs-SRB-2026-07-13-1130
./Make-specs-SRB-2026-08-03-1000
./Make-specs-CHT-2026-08-01-1800

# Run all spec files
echo "= Submitting batch files ="
sbatch --ntasks=512 SJob-Run-specs-scattered

