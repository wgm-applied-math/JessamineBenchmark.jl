#!/bin/bash

# Partial script:
# Set data_sets to an array of stems of data sets
# Set data_set_dir to the directory where data set files are found
# Set data_set_ext to the extension of the filename of a data set
# Set run_key to a configuration run key
# Set super_specs to an array of paths to super spec files
#   Note that specs earlier in the array take priority over later ones
# Then source this script.

if [[ ! -v data_sets ]] || (( ${#data_sets[*]} <= 0 ))
then
    echo "Need at least one element in data_sets"
    exit 1
fi

if [[ ! -v super_specs ]] || (( ${#super_spec[*]} <= 0 ))
then
    echo "Need at least one element in super_specs"
    exit 1
fi

if [[ ! -v data_set_dir ]]
then
    echo "Must set data_set_dir"
    exit 1
fi

if [[ ! -v data_set_ext ]]
then
    echo "Must set data_set_ext"
    exit 1
fi

if [[ ! -v run_key ]]
then
   echo "Must set run_key"
   exit 1
fi

# In bash 5.3 I can do this to get a bunch of --config-file=... strings:
# "${super_specs[@]/*/--config-file=&.toml}"
# But the cluster has an older version of bash, so I have to do this
configs=( )
for super_spec in "${super_specs[@]}"
do
    configs+="--config-file=$super_spec.toml"
done


for data_set in "${data_sets[@]}"
do
    echo "=== Working on $data_set ==="
    julia --project=@. -q -m JessamineBenchmark.AppSimple \
        setup_samples \
        "${configs[@]}" \
        --config-path-template "Specs/$run_key/$data_set-%03d.toml" \
        --sr-output-dir "Generated/$run_key" \
        --data-file "$data_set_dir/$data_set$data_set_ext" \
        || exit
done
