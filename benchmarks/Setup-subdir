#!/bin/bash

# Script to set up links in a benchmark subdirectory.
# These links point to files in ./Utils.
#
# Give the directory path relative to this directory
# as an argument to this script.
#
# Also cleans out any existing bad links.
#
# The idea is that I can replace a link with a custom file in a
# benchmark directory if that corpus doesn't quite line up with
# how all the others are structured.

# This script only needs to be run if files in ./Utils are
# restructured.  Once the links are created, they are stored in
# git and you don't need to run this script to make them again.

subdir="$1"

echo "Setting up links in $subdir"

mkdir -p "$subdir"
cd "$subdir"

# The find command means the following
# Start in . and search recursively
# Anything that matches ( Generated Specs Attic ) prune from the search process and do not go into it.
# Or: Anything that is a broken link
# print it out and delete it.
# The -xtype <t> is a little convoluted.
# It means to check whether a file is of type <t>. It follows
# links if possible and checks the target of the link.
# If the link is bad somehow, the link itself is checked
# so -xtype l only matches links that don't resolve to a non-link file.
# Then print and remove the bad link.
# There's this quirk that if you use -delete to delete files,
# find insists on enabling -depth so that it visits files before
# visiting and possibly deleting the directory that contains them.
# But then -prune doesn't work.
# And I want -prune to work because I have big directories
# full of generated files that this script should ignore.
echo "Cleaning bad links"
find . \
    \( -name Generated -o -name Specs -o -name Attic \) -prune \
    -o -xtype l \
    -print \
    -exec rm '{}' \;

for link in \
    AnalysisUtils.py \
    AssembleSymPyReports.py \
    Debug-one-spec \
    Fetch-data \
    Fetch-results \
    MakeSummaries.py \
    Module-Assemble-results.nu \
    Module-Make-specs \
    QuickReport.py \
    Run-one-spec \
    SJob-Run-some-specs \
    SJob-Run-SymPy-reports \
    SModule-Run-specs-scattered \
    SymPyReport.py
do
    if [ ! -f ../Utils/"$link" ]
    then
        echo "Bad link: $link"
        exit 1
    fi
    ln -vsf ../Utils/"$link" .
done
